<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.orderup.Scenes.Controllers.OrderController"
      alignment="CENTER"
      spacing="20"
      styleClass="center-container">

    <Text text="Order Scene" styleClass="subtitle" />
    <Text text="Receipt and cooking area" styleClass="placeholder-text" />
    <Button text="Back to Waiting Line" styleClass="btn-order" onAction="#onBack" />

</VBox>
