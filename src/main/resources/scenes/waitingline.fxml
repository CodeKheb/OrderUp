<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
      prefWidth="1280.0" prefHeight="720.0"
      stylesheets="@../stylesheets/stylesheet.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.orderup.Scenes.Controllers.WaitingLineController">

    <VBox alignment="CENTER" spacing="20.0"
          prefWidth="1280.0" prefHeight="720.0">

        <Text text="Waiting Line" styleClass="subtitle" />
        <Text text="Customer line goes here" styleClass="placeholder-text" />
        <Button text="Take Order" styleClass="btn" onAction="#onTakeOrder" />

    </VBox>
</Pane>
