<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.orderup.Scenes.Controllers.MenuController"
      alignment="CENTER"
      spacing="20"
      styleClass="center-container">

    <Text text="Order Up" styleClass="title" />
    <Button text="Play" styleClass="btn" onAction="#onPlay" />
    <Button text="Manual" styleClass="btn" onAction="#onManual" />

</VBox>
