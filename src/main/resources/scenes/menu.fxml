<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
      prefWidth="1280.0" prefHeight="720.0"
      stylesheets="@../stylesheets/stylesheet.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.orderup.Scenes.Controllers.MenuController">

    <ImageView fitWidth="1440.0" fitHeight="810.0" preserveRatio="false"
               translateX="-80.0" translateY="-45.0"
               smooth="false" cache="true">
        <image>
            <Image url="@../assets/textures/menu_animation.gif" />
        </image>
    </ImageView>

    <VBox alignment="CENTER" spacing="30.0"
          prefWidth="1280.0" prefHeight="720.0">

        <Text text="Order Up" styleClass="menu-title" />
        <Button text="Play" styleClass="btn" onAction="#onPlay" />
        <Button text="Manual" styleClass="btn" onAction="#onManual" />
        <Button text="Quit" styleClass="btn" onAction="#onQuit" />

    </VBox>
</Pane>
