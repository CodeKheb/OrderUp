<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Text?>

<Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
      styleClass="pause-overlay"
      stylesheets="@../stylesheets/stylesheet.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.orderup.Scenes.Controllers.PauseController">

    <VBox alignment="CENTER" prefHeight="800.0" prefWidth="1280.0" spacing="30.0">

        <Text text="Game Paused">
         <styleClass>
            <String fx:value="subtitle" />
            <String fx:value="paused" />
         </styleClass></Text>

        <HBox alignment="CENTER" spacing="20.0">
            <Label text="Music" styleClass="slider-label" />
            <Slider fx:id="musicVolumeSlider" min="0.0" max="1.0" value="0.65" prefWidth="260.0" styleClass="volume-slider" />
        </HBox>
        <HBox alignment="CENTER" spacing="20.0">
            <Label text="SFX" styleClass="slider-label" />
            <Slider fx:id="soundVolumeSlider" min="0.0" max="1.0" value="1.0" prefWidth="260.0" styleClass="volume-slider" />
        </HBox>

        <Button onAction="#onResume" styleClass="btn" text="Resume" />
        <Button onAction="#onShowGanttChart" styleClass="btn" text="Gantt Chart" />
        <Button onAction="#onMainMenu" styleClass="btn" text="Main Menu" />

    </VBox>
</Pane>
